{
  "hooks": {
    "pre-phase-advance": {
      "description": "Validate before advancing to next phase",
      "phases": {
        "ANALYSIS": {
          "validate": [
            "state/analysis/confirmed.json exists",
            "classification is not empty",
            "rootCauseHypothesis has at least 1 item"
          ]
        },
        "CONTEXT": {
          "validate": [
            "state/context/scope.json exists",
            "relevantFiles has at least 1 item"
          ]
        },
        "TEST": {
          "validate": [
            "state/reproduce/test-result.json or state/test/test-result.json exists",
            "testFile is not empty"
          ]
        },
        "ACCEPTANCE": {
          "validate": [
            "state/acceptance/confirmed.json exists",
            "criteria has at least 1 item"
          ]
        },
        "FIX": {
          "validate": [
            "state/fix/success.json or state/impl/success.json exists",
            "testPassed is true"
          ]
        },
        "VERIFY": {
          "validate": [
            "state/verify/report.json exists",
            "regressionStatus is 'passed'"
          ]
        },
        "OUTPUT": {
          "validate": [
            "state/output/result.json exists",
            "state/output/report.md exists"
          ]
        }
      }
    },
    "post-phase-complete": {
      "description": "Actions after phase completion",
      "phases": {
        "ANALYSIS": {
          "actions": [
            "git.tag-checkpoint checkpoint-analysis"
          ]
        },
        "CONTEXT": {
          "actions": [
            "git.tag-checkpoint checkpoint-context"
          ]
        },
        "TEST": {
          "actions": [
            "git.tag-checkpoint checkpoint-test"
          ]
        },
        "ACCEPTANCE": {
          "actions": [
            "git.tag-checkpoint checkpoint-acceptance"
          ]
        },
        "FIX": {
          "actions": [
            "git.tag-checkpoint checkpoint-fix"
          ]
        },
        "VERIFY": {
          "actions": [
            "git.tag-checkpoint checkpoint-verify"
          ]
        }
      }
    },
    "on-error": {
      "description": "Error handling hooks",
      "handlers": {
        "agent-failed": {
          "action": "prompt-user",
          "message": "Agent execution failed. Options: 1) Retry 2) Skip 3) Rollback"
        },
        "test-failed": {
          "action": "increment-loop",
          "maxRetries": 5
        },
        "validation-failed": {
          "action": "block-advance",
          "message": "Phase validation failed. Please fix the issues before advancing."
        }
      }
    }
  }
}
