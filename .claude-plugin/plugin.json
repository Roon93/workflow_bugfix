{
  "name": "workflow_bugfix",
  "version": "0.1.0",
  "description": "Automated bug fixing and feature development workflow for existing codebases",
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/your-org/workflow_bugfix",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/workflow_bugfix.git"
  },
  "keywords": [
    "bugfix",
    "tdd",
    "workflow",
    "multi-repo",
    "code-analysis",
    "automated-testing"
  ],
  "claudeCode": {
    "minVersion": "2.0.0"
  },
  "skills": [
    {
      "name": "bugfix",
      "path": "skills/bugfix-start",
      "description": "Start a bug fixing workflow"
    },
    {
      "name": "feature",
      "path": "skills/feature-start",
      "description": "Start a feature development workflow"
    },
    {
      "name": "resume",
      "path": "skills/resume-workflow",
      "description": "Resume an interrupted workflow"
    },
    {
      "name": "status",
      "path": "skills/workflow-status",
      "description": "Check current workflow status"
    },
    {
      "name": "rewind",
      "path": "skills/rewind",
      "description": "Rewind to a previous checkpoint"
    },
    {
      "name": "rebuild-index",
      "path": "skills/rebuild-index",
      "description": "Rebuild code index"
    }
  ],
  "agents": [
    {
      "name": "bugfix-lead",
      "path": "agents/bugfix-lead.md",
      "role": "coordinator"
    },
    {
      "name": "analyzer",
      "path": "agents/analyzer.md",
      "role": "specialist"
    },
    {
      "name": "locator",
      "path": "agents/locator.md",
      "role": "specialist"
    },
    {
      "name": "tester",
      "path": "agents/tester.md",
      "role": "specialist"
    },
    {
      "name": "fixer",
      "path": "agents/fixer.md",
      "role": "specialist"
    },
    {
      "name": "verifier",
      "path": "agents/verifier.md",
      "role": "specialist"
    }
  ],
  "mcp": {
    "server": "mcp/bugfix-server.json"
  },
  "hooks": {
    "config": "hooks/hooks.json"
  },
  "dependencies": {
    "node": ">=20.0.0"
  }
}
