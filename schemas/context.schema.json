{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "relevantFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": {"type": "string"},
          "path": {"type": "string"},
          "lines": {"type": "string"},
          "reason": {"type": "string"}
        },
        "required": ["repo", "path", "lines", "reason"]
      }
    },
    "relevantSymbols": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer"}
        },
        "required": ["name", "type", "file", "line"]
      }
    },
    "callChains": {
      "type": "array",
      "items": {"type": "string"}
    },
    "impactScope": {
      "type": "object",
      "properties": {
        "affectedFiles": {
          "type": "array",
          "items": {"type": "string"}
        },
        "affectedFunctions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "riskLevel": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      },
      "required": ["affectedFiles", "affectedFunctions", "riskLevel"]
    }
  },
  "required": ["relevantFiles", "relevantSymbols", "callChains", "impactScope"]
}
