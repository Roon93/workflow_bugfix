{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["fixedFiles", "testPassed", "loopRounds", "commits", "speculativeFix"],
  "properties": {
    "fixedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "path", "linesChanged", "changeType"],
        "properties": {
          "repo": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "linesChanged": {
            "type": "integer",
            "minimum": 0
          },
          "changeType": {
            "type": "string",
            "enum": ["added", "modified", "deleted"]
          }
        }
      }
    },
    "testPassed": {
      "type": "boolean"
    },
    "loopRounds": {
      "type": "integer",
      "minimum": 0
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "sha", "message"],
        "properties": {
          "repo": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "speculativeFix": {
      "type": "boolean"
    }
  }
}
