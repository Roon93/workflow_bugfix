{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "skipped"]
    },
    "testFile": {
      "type": "string"
    },
    "testName": {
      "type": "string"
    },
    "framework": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "result": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "testName": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          }
        }
      }
    }
  }
}
