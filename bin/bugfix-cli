#!/usr/bin/env node
const { StateManager } = require('../lib/state-manager.js');
const { IndexBuilder } = require('../lib/index-builder.js');
const { RepoManager } = require('../lib/repo-manager.js');
const { TestRunner } = require('../lib/test-runner.js');
const { GitOps } = require('../lib/git-ops.js');
const { LogParser } = require('../lib/log-parser.js');
const { ContextRetriever } = require('../lib/context-retriever.js');

const args = process.argv.slice(2);

// MCP stdio server 模式：实现 JSON-RPC 2.0 over stdin/stdout
if (args[0] === '--mcp') {
  startMcpServer();
} else {
  runCli(args);
}

function startMcpServer() {
  const readline = require('readline');
  const rl = readline.createInterface({ input: process.stdin, terminal: false });

  rl.on('line', async (line) => {
    let req;
    try { req = JSON.parse(line); } catch { return; }

    const { id, method, params = {} } = req;

    if (method === 'initialize') {
      send({ jsonrpc: '2.0', id, result: {
        protocolVersion: '2024-11-05',
        capabilities: { tools: {} },
        serverInfo: { name: 'bugfix', version: '0.1.0' }
      }});
      return;
    }

    if (method === 'tools/list') {
      const tools = require('../mcp/bugfix-server.json').mcpServers.bugfix.tools;
      send({ jsonrpc: '2.0', id, result: { tools } });
      return;
    }

    if (method === 'tools/call') {
      const { name, arguments: toolArgs = {} } = params;
      try {
        const result = await dispatchTool(name, toolArgs);
        send({ jsonrpc: '2.0', id, result: { content: [{ type: 'text', text: JSON.stringify(result, null, 2) }] } });
      } catch (err) {
        send({ jsonrpc: '2.0', id, error: { code: -32000, message: err.message } });
      }
      return;
    }

    // notifications (no id) — ignore silently
    if (id !== undefined) {
      send({ jsonrpc: '2.0', id, error: { code: -32601, message: `Method not found: ${method}` } });
    }
  });

  function send(obj) {
    process.stdout.write(JSON.stringify(obj) + '\n');
  }
}

async function dispatchTool(name, a) {
  switch (name) {
    case 'workflow:init': { const sm = new StateManager(); return sm.init(a.workflowId, a.type, a.repos || []); }
    case 'workflow:load': { const sm = new StateManager(); return sm.load(); }
    case 'workflow:advance': { const sm = new StateManager(); return sm.advance(a.phase, a.checkpoint !== false); }
    case 'workflow:rollback': { const sm = new StateManager(); return sm.rollback(a.phase, a.checkpointTag); }
    case 'log:parse': { const lp = new LogParser(); return lp.parse(a.logFile, { maxErrorSamples: a.maxErrorSamples || 20 }); }
    case 'log:extract-clues': { const lp = new LogParser(); return lp.extractClues(a.logFile, a.keywords || []); }
    case 'index:build': {
      const db = new IndexBuilder('.bugfix/index.db');
      for (const repo of (a.repos || ['./'])) db.indexDirectory(repo, repo);
      const stats = db.db.prepare('SELECT COUNT(*) as n FROM files').get();
      const syms = db.db.prepare('SELECT COUNT(*) as n FROM symbols').get();
      const calls = db.db.prepare('SELECT COUNT(*) as n FROM calls').get();
      db.close();
      return { success: true, stats: { filesIndexed: stats.n, symbolsIndexed: syms.n, callsIndexed: calls.n } };
    }
    case 'index:search-files': { const db = new IndexBuilder('.bugfix/index.db'); const r = db.searchFiles(a.keywords, a.repos, a.language, a.maxResults); db.close(); return { files: r }; }
    case 'index:search-symbols': { const db = new IndexBuilder('.bugfix/index.db'); const r = db.searchSymbols(a.name, a.type, a.repos); db.close(); return { symbols: r }; }
    case 'index:trace-calls': { const db = new IndexBuilder('.bugfix/index.db'); const r = db.traceCalls(a.symbol, a.direction, a.maxDepth); db.close(); return { callChain: r }; }
    case 'index:analyze-impact': { const db = new IndexBuilder('.bugfix/index.db'); const r = db.analyzeImpact(a.files, a.symbols); db.close(); return r; }
    case 'test:discover': { const tr = new TestRunner(); return tr.discover(a.repos || ['./'], a.languages || []); }
    case 'test:run': { const tr = new TestRunner(); return tr.run(a.testFile, a.testName, a.framework, a.timeout); }
    case 'git:create-branch': { const g = new GitOps(); return g.createBranch(a.branchName, a.repos || ['./'], a.baseBranch); }
    case 'git:commit': { const g = new GitOps(); return g.commit(a.message, a.files, a.repos || ['./']); }
    case 'git:tag-checkpoint': { const g = new GitOps(); return g.tagCheckpoint(a.tag, a.message, a.repos || ['./']); }
    case 'git:rewind': { const g = new GitOps(); return g.rewind(a.checkpointTag, a.repos || ['./']); }
    case 'repo:list': { const rm = new RepoManager(); return rm.list(); }
    case 'repo:sync-branches': { const rm = new RepoManager(); return rm.syncBranches(a.branchName, a.repos); }
    case 'repo:sync-commits': { const rm = new RepoManager(); return rm.syncCommits(a.message, a.repos); }
    default: throw new Error(`Unknown tool: ${name}`);
  }
}

function runCli(args) {
  const command = args[0];

function output(result) {
  console.log(JSON.stringify(result, null, 2));
}

// Workflow commands
if (command === 'workflow:init') {
  const [workflowId, type] = args.slice(1);
  const sm = new StateManager();
  output(sm.init(workflowId, type, []));
}
else if (command === 'workflow:load') {
  const sm = new StateManager();
  output(sm.load());
}
else if (command === 'workflow:advance') {
  const phase = args[1];
  const sm = new StateManager();
  output(sm.advance(phase));
}
else if (command === 'workflow:rollback') {
  const [phase, tag] = args.slice(1);
  const sm = new StateManager();
  output(sm.rollback(phase, tag));
}
// Index commands
else if (command === 'index:build') {
  const builder = new IndexBuilder('.bugfix/index.db');
  builder.indexDirectory('./');
  builder.close();
  output({ success: true });
}
else if (command === 'index:search-files') {
  const keywords = args.slice(1);
  const retriever = new ContextRetriever();
  retriever.searchFiles(keywords).then(result => {
    retriever.close();
    output(result);
  });
}
else if (command === 'index:search-symbols') {
  const name = args[1];
  const retriever = new ContextRetriever();
  retriever.searchSymbols(name).then(result => {
    retriever.close();
    output(result);
  });
}
else if (command === 'index:trace-calls') {
  const symbol = args[1];
  const retriever = new ContextRetriever();
  retriever.traceCalls(symbol).then(result => {
    retriever.close();
    output(result);
  });
}
else if (command === 'index:analyze-impact') {
  const files = args.slice(1);
  const retriever = new ContextRetriever();
  retriever.analyzeImpact(files).then(result => {
    retriever.close();
    output(result);
  });
}
// Log commands
else if (command === 'log:parse') {
  const logFile = args[1];
  const parser = new LogParser();
  output(parser.parse(logFile));
}
else if (command === 'log:extract-clues') {
  const logFile = args[1];
  const parser = new LogParser();
  output(parser.extractClues(logFile, []));
}
// Test commands
else if (command === 'test:discover') {
  const runner = new TestRunner();
  output(runner.discover(['./'], ['c', 'cpp', 'typescript', 'python']));
}
else if (command === 'test:run') {
  const testFile = args[1];
  const runner = new TestRunner();
  output(runner.run(testFile, null, null));
}
// Git commands
else if (command === 'git:create-branch') {
  const branchName = args[1];
  const gitOps = new GitOps();
  gitOps.createBranch(branchName, 'main', ['./']).then(output);
}
else if (command === 'git:commit') {
  const message = args[1];
  const gitOps = new GitOps();
  gitOps.commit(message, [], ['./']).then(output);
}
else if (command === 'git:tag-checkpoint') {
  const [tag, message] = args.slice(1);
  const gitOps = new GitOps();
  gitOps.tagCheckpoint(tag, message, ['./']).then(output);
}
else if (command === 'git:rewind') {
  const tag = args[1];
  const gitOps = new GitOps();
  gitOps.rewind(tag, ['./']).then(output);
}
// Repo commands
else if (command === 'repo:list') {
  const rm = new RepoManager();
  output(rm.list());
}
else if (command === 'repo:validate') {
  const rm = new RepoManager();
  const repos = rm.list();
  output(rm.validateRepos(repos));
}
else {
  console.error('Unknown command:', command);
  console.error('Usage: bugfix-cli <command> [args...]');
  process.exit(1);
}
} // end runCli
